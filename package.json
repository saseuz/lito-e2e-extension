{
  "name": "lito-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:dev": "tsc --noEmit && vite build --mode development",
    "build:firefox": "node scripts/build-browser.mjs firefox production",
    "build:firefox:dev": "node scripts/build-browser.mjs firefox development",
    "build:safari": "node scripts/build-browser.mjs safari production",
    "build:safari:dev": "node scripts/build-browser.mjs safari development",
    "build:all:dev": "node scripts/build-browser.mjs chromium development && node scripts/build-browser.mjs firefox development && node scripts/build-browser.mjs safari development",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.54.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.0"
  }
}
